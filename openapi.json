{
  "openapi": "3.0.3",
  "info": {
    "title": "CMS Portal User Management API",
    "version": "1.0.0",
    "description": "Admin-only management of user accounts.\n\nAuthentication: every operation requires an authenticated, active Django session (session cookie). Unsafe methods (POST, PATCH, DELETE) additionally require a valid CSRF token, accepted as the X-CSRFToken header.\n\nErrors: validation failures return 400 with {\"errors\": {field: [messages]}}; rejected operations return {\"detail\": \"...\"} with 401 (unauthenticated), 403 (non-Admin or inactive), or 409 (protected operation, e.g. superuser is read-only or self-deletion). Unknown user IDs return 404. Undocumented methods return 405."
  },
  "paths": {
    "/api/users/": {
      "get": {
        "summary": "List users",
        "description": "Returns users ordered by ascending ID, paginated. `search` filters by case-insensitive email substring; a blank value is ignored.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number, starting at 1.",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Number of results per page, at most 100.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive substring matched against user emails. Blank or whitespace-only values are ignored.",
            "schema": { "type": "string" }
          },
          {
            "name": "is_active",
            "in": "query",
            "description": "Filter by active status.",
            "schema": { "type": "string", "enum": ["true", "false"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated page of users.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserListEnvelope" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      },
      "post": {
        "summary": "Create a user",
        "description": "Creates a user with a hashed password and exactly one role. Email and username must be unique (email case-insensitively); `is_active` defaults to true.",
        "security": [{ "sessionAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserCreateRequest" } } }
        },
        "responses": {
          "201": {
            "description": "User created. The response never contains the password or its hash.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/api/users/{user_id}/": {
      "get": {
        "summary": "View a user",
        "parameters": [
          { "$ref": "#/components/parameters/UserId" }
        ],
        "responses": {
          "200": {
            "description": "The requested user.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      },
      "patch": {
        "summary": "Update a user",
        "description": "Partially updates a user: only supplied fields change, an omitted password leaves the stored hash unchanged, and a supplied password is validated then re-hashed. Role replacement assigns exactly one group.",
        "security": [{ "sessionAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/UserId" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserUpdateRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Updated user. The response never contains the password or its hash.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Rejected protected operation: superuser accounts are read-only, you cannot deactivate your own account, and the last active Admin cannot be demoted or deactivated.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      },
      "delete": {
        "summary": "Delete a user",
        "description": "Hard-deletes the user. Blocked with 409 for superuser accounts, your own account, and the last active Admin.",
        "security": [{ "sessionAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/UserId" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "responses": {
          "204": { "description": "User deleted; the row is removed from the database." },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Rejected protected operation: superuser accounts are read-only, you cannot delete your own account, and the last active Admin cannot be deleted.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid",
        "description": "Django session authentication. Log in first (e.g. via the Django session machinery); unsafe methods also require the CSRF token from the csrftoken cookie, sent as the X-CSRFToken header."
      }
    },
    "parameters": {
      "UserId": {
        "name": "user_id",
        "in": "path",
        "description": "Primary key of the user.",
        "required": true,
        "schema": { "type": "integer", "minimum": 1 }
      },
      "CsrfToken": {
        "name": "X-CSRFToken",
        "in": "header",
        "description": "Django CSRF token (from the csrftoken cookie).",
        "required": true,
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Input validation failed (invalid values, missing or unknown fields, or rejected password).",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } }
      },
      "Unauthenticated": {
        "description": "No authenticated session.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "Authenticated but not an active Admin.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "No user exists with this ID.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "MethodNotAllowed": {
        "description": "The route does not accept this method.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "description": "User representation returned by all successful operations. Never contains credentials.",
        "additionalProperties": false,
        "required": ["id", "username", "email", "first_name", "last_name", "role", "is_active", "date_joined"],
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string", "maxLength": 150 },
          "email": { "type": "string", "format": "email" },
          "first_name": { "type": "string", "maxLength": 150 },
          "last_name": { "type": "string", "maxLength": 150 },
          "role": {
            "type": "string",
            "description": "The assigned role; superusers always report Admin.",
            "enum": ["Admin", "Editor", "Author"]
          },
          "is_active": { "type": "boolean" },
          "date_joined": { "type": "string", "format": "date-time" }
        }
      },
      "UserCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "email", "password", "role"],
        "properties": {
          "username": { "type": "string", "maxLength": 150 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Stored hashed. Validated by Django's configured validators (length, similarity, common/password lists)."
          },
          "role": { "type": "string", "enum": ["Admin", "Editor", "Author"] },
          "first_name": { "type": "string", "maxLength": 150 },
          "last_name": { "type": "string", "maxLength": 150 },
          "is_active": { "type": "boolean", "default": true }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "description": "Partial update: omitted fields keep their existing values.",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "username": { "type": "string", "maxLength": 150 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Omit to leave the stored hash unchanged."
          },
          "role": { "type": "string", "enum": ["Admin", "Editor", "Author"] },
          "first_name": { "type": "string", "maxLength": 150 },
          "last_name": { "type": "string", "maxLength": 150 },
          "is_active": { "type": "boolean" }
        }
      },
      "UserListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count", "page", "page_size", "total_pages", "results"],
        "properties": {
          "count": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "page_size": { "type": "integer", "minimum": 1, "maximum": 100 },
          "total_pages": { "type": "integer", "minimum": 0 },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
        }
      },
      "ValidationError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["errors"],
        "properties": {
          "errors": {
            "type": "object",
            "description": "Field name(s) mapped to the list of error messages. Unknown fields are keyed by the offending field name.",
            "additionalProperties": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["detail"],
        "properties": { "detail": { "type": "string" } }
      }
    }
  },
  "security": [{ "sessionAuth": [] }]
}
